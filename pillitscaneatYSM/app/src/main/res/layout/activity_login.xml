<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- 상단 여백(Safe Area) 적용됨 -->
    <!-- 🔵 TOP BAR 삽입 -->
    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/top_bar" />

    <!-- 회원가입으로 이동 버튼 -->
    <Button
        android:id="@+id/btnGoSignup"
        android:layout_width="130dp"
        android:layout_height="48dp"
        android:layout_below="@id/btnLogin"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="30dp"
        android:text="회원가입"
        android:textColor="#1E2A5E"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_yellow_border"
        android:padding="8dp"
        android:gravity="center" />



    <!-- 상태바 만큼 여백 -->

    <!-- 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btnBackLogin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="10dp"
        android:src="@android:drawable/ic_media_previous"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:layout_alignParentStart="true"
        android:padding="8dp" />

    <!-- 로고 텍스트 -->
    <TextView
        android:id="@+id/tvLogoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#1E2A5E"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/btnBackLogin"
        android:layout_marginTop="40dp" />

    <!-- 입력 박스 -->
    <LinearLayout
        android:id="@+id/loginBox"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvLogoLogin"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:background="#F8ECC2"
        android:padding="20dp"
        android:layout_marginTop="40dp"
        android:elevation="4dp"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/id_label"
            android:textStyle="bold"
            android:textColor="#1E2A5E"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:textColorHint="#999999"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/password_label"
            android:textStyle="bold"
            android:textColor="#1E2A5E"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:inputType="textPassword"
            android:textColorHint="#999999"
            android:minHeight="48dp" />
    </LinearLayout>

    <!-- 로그인 버튼 -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="130dp"
        android:layout_height="48dp"
        android:layout_below="@id/loginBox"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="30dp"
        android:text="로그인"
        android:textColor="#1E2A5E"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_yellow_border"
        android:padding="8dp"
        android:gravity="center" />

    <!-- 하단 포인트 바 -->
    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@drawable/bottom_bar"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp" />

    <View
        android:id="@+id/bottomBar2"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bottom_bar" />
    <!-- 네비게이션바(홈바) 만큼 여백 -->

</RelativeLayout>
