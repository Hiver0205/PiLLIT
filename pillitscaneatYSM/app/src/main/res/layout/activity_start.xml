<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">   <!-- 🔥 상태바·내비게이션바와 겹침 방지 -->

    <!-- 🔵 TOP BAR 삽입 -->
    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/top_bar" />
    <!-- 🔥 상태바 높이만큼 아래로 -->

    <!-- 🔵 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btnBackStart"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="10dp"
        android:src="@android:drawable/ic_media_previous"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:layout_alignParentStart="true"
        android:padding="8dp" />

    <!-- 🔵 앱 로고 -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/btnBackStart"
        android:layout_marginTop="60dp"
        android:src="@drawable/scaneat_logo"
        android:contentDescription="@string/app_name" />

    <!-- 🔵 앱 이름 -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#1E2A5E"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/logoImage"
        android:layout_marginTop="20dp" />

    <!-- 🔵 로그인 버튼 -->
    <Button
        android:id="@+id/btnLoginStart"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/login_button"
        android:textColor="#1E2A5E"
        android:background="@drawable/rounded_button_yellow_border"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvAppName"
        android:layout_marginTop="50dp"
        android:padding="12dp"
        android:textStyle="bold" />

    <!-- 🔵 회원가입 버튼 -->
    <Button
        android:id="@+id/btnSignupStart"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/signup_button"
        android:textColor="#1E2A5E"
        android:background="@drawable/rounded_button_yellow_border"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/btnLoginStart"
        android:layout_marginTop="20dp"
        android:padding="12dp"
        android:textStyle="bold" />

    <!-- 🔵 하단 포인트 바 -->
    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bottom_bar" /> <!-- 🔥 네비게이션바와 겹침 방지 -->

</RelativeLayout>
