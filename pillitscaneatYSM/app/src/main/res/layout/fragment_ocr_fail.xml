<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 실패 아이콘 -->
    <ImageView
        android:id="@+id/pillit_retry"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/pillit_retry"
        android:layout_marginBottom="20dp" />

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/pillit_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="인식을 실패했습니다"
        android:textColor="#1E2A5E"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/pillit_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="약품 성분을 확인할 수 없어요.\n다른 사진으로 다시 시도해주세요."
        android:textColor="#555555"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <!-- 버튼 -->
    <Button
        android:id="@+id/btnRetry"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="스캔으로 돌아가기"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_round_navy"
        android:padding="12dp" />

</LinearLayout>
