<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- 🔵 TOP BAR -->
        <View
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/top_bar" />

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBackSignup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="10dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@android:color/transparent"
            android:padding="8dp" />

        <!-- 로고 텍스트 -->
        <TextView
            android:id="@+id/tvLogoSignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#1E2A5E"
            android:layout_gravity="center"
            android:layout_marginTop="20dp" />

        <!-- 입력 박스 -->
        <LinearLayout
            android:id="@+id/signupBox"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="#F8ECC2"
            android:padding="20dp"
            android:layout_marginTop="40dp"
            android:elevation="4dp">

            <!-- 이름 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/id_label1"
                android:textStyle="bold"
                android:textColor="#1E2A5E"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etIdSignup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:background="#FFFFFF"
                android:padding="12dp"/>

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textStyle="bold"
                android:textColor="#1E2A5E"
                android:textSize="18sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEmailSignup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:inputType="textEmailAddress" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textStyle="bold"
                android:textColor="#1E2A5E"
                android:textSize="18sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPwSignup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- 회원가입 완료 버튼 -->
        <Button
            android:id="@+id/btnCreate"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:text="회원가입 완료"
            android:textColor="#1E2A5E"
            android:textStyle="bold"
            android:background="@drawable/rounded_button_yellow_border" />

        <!-- 하단 여백 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>
