<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">




    <!-- 🔵 하단 포인트 바 -->
    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@drawable/bottom_bar"
        android:layout_alignParentBottom="true" />

    <!-- 🔵 중앙 내용 묶음 -->
    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_centerInParent="true"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- 제목 -->
        <TextView
            android:id="@+id/titleUserInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_title"
            android:textSize="28sp"
            android:textColor="#1E2A5E"
            android:textStyle="bold"
            android:layout_marginBottom="40dp" />

        <!-- 이름 -->
        <TextView
            android:id="@+id/textName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_name"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="20dp" />

        <!-- 이메일 -->
        <TextView
            android:id="@+id/textEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_email"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="20dp" />

        <!-- 알레르기 -->
        <TextView
            android:id="@+id/textAllergies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_allergy"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="40dp" />

        <!-- 알레르기 수정 버튼 -->
        <Button
            android:id="@+id/btnEditAllergy"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="@string/userinfo_edit_allergy"
            android:textColor="#1E2A5E"
            android:textStyle="bold"
            android:background="@drawable/btn_yellow"
            android:layout_marginBottom="20dp"/>

        <!-- 비밀번호 변경 버튼 -->
        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="@string/userinfo_change_pw"
            android:textColor="#1E2A5E"
            android:textStyle="bold"
            android:background="@drawable/btn_yellow" />

    </LinearLayout>

</RelativeLayout>
